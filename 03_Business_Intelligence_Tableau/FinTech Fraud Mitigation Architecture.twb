      <aliases enabled='yes' />
      <column caption='Fraudulent Incidents Detected' datatype='integer' name='[Actual_Fraud_Status]' role='measure' type='quantitative' />
      <column caption='Transaction Value' datatype='real' default-format='c&quot;$&quot;#,##0,,M;(&quot;$&quot;#,##0,,M)' name='[Amount]' role='measure' type='quantitative' />
      <column caption='Approval Rate %' datatype='real' default-format='p0.0%' name='[Calculation_1569337243381761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [automated_decision] = &apos; AUTO-APPROVE&apos; THEN 1 ELSE 0 END) / COUNT([Customer_ID])' />
      </column>
      <column caption='Total Fraud Prevented' datatype='real' name='[Calculation_1569337952157706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Actual_Fraud_Status] = 1 THEN [Amount] ELSE 0 END' />
      </column>
      <column caption='Friction Cost' datatype='real' name='[Calculation_1569337953034251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [automated_decision] = &apos;⚠️ STEP-UP (OTP/MFA)&apos; AND [Actual_Fraud_Status] = 0 THEN [Amount] END) * 0.02 * 0.05' />
      </column>
      <column caption='Final Net Benefit' datatype='real' name='[Calculation_1569337961017357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM(IF [Actual_Fraud_Status] = 1 THEN [Amount] END)) &#13;&#10;- &#13;&#10;ZN(SUM(IF [automated_decision] = &apos;⚠️ STEP-UP (OTP/MFA)&apos; AND [Actual_Fraud_Status] = 0 THEN [Amount] END) * 0.02 * 0.05)' />
      </column>
      <column caption='Risk Level Label' datatype='string' name='[Calculation_1569338024013838]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [total_risk_score]&#13;&#10;    WHEN 15 THEN &quot;Safe Baseline&quot;&#13;&#10;    WHEN 35 THEN &quot;Pre-Alert Zone&quot;&#13;&#10;    WHEN 40 THEN &quot;MFA Gateway (Verification Required)&quot;&#13;&#10;    WHEN 55 THEN &quot;Elevated Suspicion&quot;&#13;&#10;    WHEN 70 THEN &quot;Strategic Equilibrium (Optimal Point)&quot;&#13;&#10;    ELSE &quot;Custom Score&quot;&#13;&#10;END' />
      </column>
      <column caption='Customer ID' datatype='string' name='[Customer_ID]' role='dimension' type='nominal' />
      <column caption='Device OS' datatype='string' name='[Device_OS]' role='dimension' type='nominal' />
      <column caption='Is Rooted' datatype='integer' name='[Is_Rooted]' role='measure' type='quantitative' />
      <column caption='Transaction Type' datatype='string' name='[Transaction_Type]' role='dimension' type='nominal' />
      <column caption='Total Transactions' datatype='table' name='[__tableau_internal_object_id__].[fraud_decision_results.csv_28F89E4C8E144784AD90E7B5F2E1B467]' role='measure' type='quantitative' />
      <column caption='Automated Decision' datatype='string' name='[automated_decision]' role='dimension' type='nominal' />
      <column caption='Pts Deviation' datatype='integer' name='[pts_deviation]' role='measure' type='quantitative' />
      <column caption='Pts Device' datatype='integer' name='[pts_device]' role='measure' type='quantitative' />
      <column caption='Pts Type' datatype='integer' name='[pts_type]' role='measure' type='quantitative' />
      <column caption='Pts Velocity' datatype='integer' name='[pts_velocity]' role='measure' type='quantitative' />
      <column caption='Total Risk Score' datatype='integer' name='[total_risk_score]' role='measure' type='quantitative' />
      <column-instance column='[Amount]' derivation='Count' name='[cnt:Amount:qk]' pivot='key' type='quantitative' />
      <column-instance column='[automated_decision]' derivation='None' name='[none:automated_decision:nk]' pivot='key' type='nominal' />
      <column-instance column='[Actual_Fraud_Status]' derivation='Sum' name='[sum:Actual_Fraud_Status:qk]' pivot='key' type='quantitative' />
      <group caption='Action (Transaction Type)' hidden='true' name='[Action (Transaction Type)]' name-style='unqualified' user:auto-column='sheet_link'>
        <groupfilter function='crossjoin'>
          <groupfilter function='level-members' level='[Transaction_Type]' />
        </groupfilter>
      </group>
